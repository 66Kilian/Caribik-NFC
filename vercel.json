{
  "headers": [
    { "source": "/(.*)\\.vcf", "headers": [
      { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
      { "key": "Content-Disposition", "value": "inline; filename=\"caribik.vcf\"" }
    ]},
    { "source": "/img/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=2592000" } ] }
  ]
}
